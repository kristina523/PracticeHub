# Database
DATABASE_URL="postgresql://user:password@localhost:5432/practicehub?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS (и ссылки «Открыть на сайте» из Telegram-бота на курс)
FRONTEND_URL=http://localhost:3000

# Восстановление пароля (письмо со ссылкой). Без SMTP ссылка пишется в лог сервера;
# в NODE_ENV=development API может вернуть devResetUrl в ответе /api/auth/forgot-password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
ADMIN_CHAT_ID="your-telegram-chat-id-for-notifications"
# Если с ПК не открывается api.telegram.org (EFATAL / AggregateError) — HTTP(S) прокси для запросов бота:
# TELEGRAM_HTTP_PROXY=http://127.0.0.1:7890
# Либо стандартные HTTPS_PROXY / HTTP_PROXY
# При странных сетевых ошибках на Windows можно попробовать в терминале перед запуском:
# set NODE_OPTIONS=--dns-result-order=ipv4first
# TELEGRAM_PUBLIC_BOT_USERNAME=PracticeHubPracticeBot
# (без @; только после того, как в @BotFather задано ТО ЖЕ имя — иначе ссылка ведёт не на вашего бота)
# Contacts (used by Telegram bot)
SUPPORT_CONTACTS="Email: support@practicehub.local\nТелефон: +7 (999) 123-45-67"

# Privacy policy (optional). Если указать — бот покажет ссылку в согласии.
# Если пусто — ссылки не будет, вместо неё бот предложит запросить документ у поддержки.
# PRIVACY_POLICY_URL=https://example.org/privacy

